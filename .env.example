# URL base de la API.
# En desarrollo se deja como ruta relativa para que el proxy de Vite sirva la API
# desde el mismo origen: así la cookie httpOnly del token de refresco no es de
# tercera parte y el navegador no la descarta.
VITE_API_BASE_URL=/api/v1

# Destino real del proxy de desarrollo.
VITE_API_PROXY_TARGET=http://localhost:4000

# Nombre neutro para el primer pintado, antes de que la API devuelva la marca de
# la empresa. Nunca poner aquí el nombre de un cliente concreto.
VITE_APP_NAME=Inventra

# Los mapas exponen el código fuente original. Mantener apagados en despliegues públicos.
VITE_ENABLE_SOURCEMAPS=false
